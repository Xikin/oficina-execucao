NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgresql://execucao:execucao_local@localhost:5434/execucao_db

JWT_SECRET=O_MESMO_JWT_SECRET_DO_OS_SERVICE_32_CHARS

RABBITMQ_URL=amqp://oficina:oficina_local@localhost:5672
RABBITMQ_EXCHANGE=oficina.saga
MENSAGERIA_MAX_TENTATIVAS=5
MENSAGERIA_ATRASO_RETENTATIVA_MS=5000
OUTBOX_INTERVALO_MS=1000

LOG_LEVEL=info
SWAGGER_ENABLED=true
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=oficina-execucao
